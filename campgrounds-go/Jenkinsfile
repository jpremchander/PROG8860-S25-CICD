pipeline {
    agent any
    
    environment {
        // Application settings
        APP_NAME = 'yelpcamp-go'
        DOCKER_IMAGE = 'yelpcamp-go'
        DOCKER_TAG = "${BUILD_NUMBER}"
        
        // Project directory
        PROJECT_DIR = "campgrounds-go"
        
        // Go environment
        CGO_ENABLED = '0'
        GOOS = 'linux'
        GOARCH = 'amd64'
        PATH = "/usr/local/go/bin:${env.PATH}"
        GOPATH = "${WORKSPACE}/go"
    }
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip running tests'
        )
        booleanParam(
            name: 'DEPLOY_LOCALLY',
            defaultValue: true,
            description: 'Deploy to localhost'
        )
    }
    
    stages {
        stage('Setup Environment') {
            steps {
                echo "🔧 Setting up build environment..."
                
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Loading environment variables from .env file..."
                        if [ -f .env ]; then
                            echo "✅ .env file found"
                            # Export all variables from .env file
                            set -a
                            source .env
                            set +a
                            
                            echo "Environment variables loaded:"
                            echo "- GITHUB_USERNAME: ${GITHUB_USERNAME}"
                            echo "- CLOUDINARY_CLOUD_NAME: ${CLOUDINARY_CLOUD_NAME}"
                            echo "- MONGO_HOST: ${MONGO_HOST}"
                            echo "- S3_BUCKET: ${S3_BUCKET}"
                        else
                            echo "❌ .env file not found!"
                            exit 1
                        fi
                        
                        echo "Verifying Go installation..."
                        go version
                        
                        echo "Setting up Go workspace..."
                        mkdir -p $GOPATH/bin
                        export PATH=$PATH:$GOPATH/bin
                        
                        echo "✅ Environment setup completed"
                    '''
                }
                
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                    env.BUILD_TIMESTAMP = sh(
                        script: "date +%Y%m%d-%H%M%S",
                        returnStdout: true
                    ).trim()
                }
                
                echo "📋 Build Info:"
                echo "  - Environment: ${params.ENVIRONMENT ?: 'dev'}"
                echo "  - Git Commit: ${env.GIT_COMMIT_SHORT}"
                echo "  - Build Number: ${BUILD_NUMBER}"
                echo "  - Timestamp: ${env.BUILD_TIMESTAMP}"
            }
        }
        
        stage('Fix Dependencies') {
            steps {
                echo "🔧 Fixing Go module dependencies..."
                
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Loading environment variables..."
                        set -a
                        source .env
                        set +a
                        
                        echo "Current directory: $(pwd)"
                        echo "Checking current go.mod..."
                        cat go.mod
                        
                        echo "Setting up Git authentication using environment variables..."
                        
                        # Method 1: Git credential helper
                        git config --global credential.helper store
                        echo "https://${GITHUB_USERNAME}:${GITHUB_PASSWORD}@github.com" > ~/.git-credentials
                        chmod 600 ~/.git-credentials
                        
                        # Method 2: URL rewriting for all GitHub access
                        git config --global url."https://${GITHUB_USERNAME}:${GITHUB_PASSWORD}@github.com/".insteadOf "https://github.com/"
                        git config --global url."https://${GITHUB_USERNAME}:${GITHUB_PASSWORD}@github.com/".insteadOf "git@github.com:"
                        git config --global url."https://${GITHUB_USERNAME}:${GITHUB_PASSWORD}@github.com/".insteadOf "git://github.com/"
                        
                        # Method 3: .netrc file
                        cat > ~/.netrc << EOF
machine github.com
login ${GITHUB_USERNAME}
password ${GITHUB_PASSWORD}

machine api.github.com
login ${GITHUB_USERNAME}
password ${GITHUB_PASSWORD}
EOF
                        chmod 600 ~/.netrc
                        
                        echo "Removing go.sum to force fresh dependency resolution..."
                        rm -f go.sum
                        
                        echo "Setting Go environment from .env variables..."
                        export GOPROXY=${GOPROXY}
                        export GOSUMDB=${GOSUMDB}
                        export GIT_TERMINAL_PROMPT=${GIT_TERMINAL_PROMPT}
                        export GONOPROXY=""
                        export GONOSUMDB=""
                        export GOPRIVATE=""
                        
                        echo "Cleaning module cache..."
                        go clean -modcache
                        
                        echo "Testing Git access to GitHub..."
                        git ls-remote https://github.com/gin-gonic/gin.git HEAD || echo "Git access test failed"
                        
                        echo "Downloading modules with authentication..."
                        go mod download
                        
                        echo "Tidying modules..."
                        go mod tidy
                        
                        echo "Verifying modules..."
                        go mod verify
                        
                        echo "Final go.mod:"
                        cat go.mod
                        echo "Final go.sum (first 10 lines):"
                        head -10 go.sum || echo "go.sum is empty or doesn't exist"
                        
                        echo "Cleaning up credentials..."
                        rm -f ~/.git-credentials ~/.netrc
                        git config --global --unset-all url."https://${GITHUB_USERNAME}:${GITHUB_PASSWORD}@github.com/".insteadOf || true
                        
                        echo "✅ Dependencies fixed successfully"
                    '''
                }
            }
        }
        
        stage('Lint & Static Analysis') {
            steps {
                echo "🔍 Running lint and static analysis..."
                
                dir("${PROJECT_DIR}") {
                    script {
                        try {
                            sh '''
                                # Load environment variables
                                set -a
                                source .env
                                set +a
                                
                                echo "Installing golangci-lint..."
                                curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $GOPATH/bin v1.54.2
                                export PATH=$PATH:$GOPATH/bin
                                
                                echo "Running golangci-lint..."
                                golangci-lint run --timeout=5m --out-format=checkstyle > golangci-lint-report.xml || echo "Lint issues found"
                                
                                echo "Running go vet..."
                                go vet ./... || echo "Go vet issues found"
                                
                                echo "Checking go fmt..."
                                if [ "$(gofmt -s -l . | wc -l)" -gt 0 ]; then
                                    echo "❌ Code formatting issues found:"
                                    gofmt -s -l .
                                    echo "Please run 'go fmt ./...' to fix formatting"
                                else
                                    echo "✅ Code formatting is correct"
                                fi
                            '''
                            
                            echo "✅ Lint and static analysis completed"
                        } catch (Exception e) {
                            echo "⚠️ Lint issues found, but continuing..."
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/golangci-lint-report.xml", allowEmptyArchive: true
                }
            }
        }
        
        stage('Test') {
            when {
                expression { return !params.SKIP_TESTS }
            }
            steps {
                echo "🧪 Running tests..."
                
                dir("${PROJECT_DIR}") {
                    script {
                        try {
                            sh '''
                                # Load environment variables
                                set -a
                                source .env
                                set +a
                                
                                echo "Running tests with coverage..."
                                go test -v -race -coverprofile=coverage.out ./... 2>&1 | tee test-results.txt
                                
                                echo "Generating coverage report..."
                                go tool cover -html=coverage.out -o coverage.html
                                go tool cover -func=coverage.out > coverage-summary.txt
                                
                                echo "Test Coverage Summary:"
                                cat coverage-summary.txt
                                
                                echo "✅ Tests completed successfully"
                            '''
                            
                            echo "✅ Tests completed successfully"
                        } catch (Exception e) {
                            echo "❌ Tests failed!"
                            sh 'cat test-results.txt || echo "No test results file found"'
                            error("Tests failed - stopping pipeline")
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/coverage.out,${PROJECT_DIR}/coverage.html,${PROJECT_DIR}/coverage-summary.txt,${PROJECT_DIR}/test-results.txt", allowEmptyArchive: true
                }
            }
        }
        
        stage('Build Application') {
            steps {
                echo "🏗️ Building Go application..."
                
                dir("${PROJECT_DIR}") {
                    sh '''
                        # Load environment variables
                        set -a
                        source .env
                        set +a
                        
                        echo "Building Go binary..."
                        go build -a -installsuffix cgo -ldflags="-w -s" -o yelpcamp-app .
                        
                        echo "Verifying binary..."
                        ls -la yelpcamp-app
                        file yelpcamp-app || echo "file command not available"
                        
                        echo "Creating application archive..."
                        mkdir -p artifacts
                        cp yelpcamp-app artifacts/
                        cp -r templates artifacts/ 2>/dev/null || echo "No templates directory"
                        cp -r public artifacts/ 2>/dev/null || echo "No public directory"
                        cp docker-compose*.yml artifacts/ 2>/dev/null || echo "No docker-compose files"
                        cp Dockerfile* artifacts/ 2>/dev/null || echo "No Dockerfile"
                        cp .env artifacts/
                        
                        # Create versioned archive
                        tar -czf yelpcamp-app-${BUILD_NUMBER}-${GIT_COMMIT_SHORT}.tar.gz -C artifacts .
                        
                        echo "Archive created: yelpcamp-app-${BUILD_NUMBER}-${GIT_COMMIT_SHORT}.tar.gz"
                        ls -la *.tar.gz
                    '''
                }
                
                echo "✅ Application build completed"
            }
            post {
                always {
                    archiveArtifacts artifacts: "${PROJECT_DIR}/*.tar.gz", fingerprint: true
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                echo "🐳 Building Docker images..."
                
                dir("${PROJECT_DIR}") {
                    script {
                        try {
                            sh '''
                                # Load environment variables
                                set -a
                                source .env
                                set +a
                                
                                echo "Building application Docker image..."
                                docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                                docker build -t ${DOCKER_IMAGE}:latest .
                                
                                # Tag for environment
                                ENVIRONMENT=${ENVIRONMENT:-dev}
                                if [ "${ENVIRONMENT}" = "prod" ]; then
                                    docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:prod
                                else
                                    docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:dev
                                fi
                                
                                echo "Docker images built successfully:"
                                docker images | grep ${DOCKER_IMAGE} || echo "No images found with name ${DOCKER_IMAGE}"
                            '''
                            
                            echo "✅ Docker images built successfully"
                        } catch (Exception e) {
                            echo "❌ Docker build failed: ${e.getMessage()}"
                            echo "Continuing without Docker images..."
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
        
        stage('Upload Artifacts to S3') {
            steps {
                echo "☁️ Uploading artifacts to S3..."
                
                dir("${PROJECT_DIR}") {
                    script {
                        try {
                            sh '''
                                # Load environment variables
                                set -a
                                source .env
                                set +a
                                
                                echo "S3 Bucket: ${S3_BUCKET}"
                                echo "AWS Region: ${AWS_REGION}"
                                echo "IAM Role: ${IAM_ROLE}"
                            '''
                            
                            withAWS(role: readFile("${PROJECT_DIR}/.env").split('\n').find { it.startsWith('IAM_ROLE=') }?.split('=')[1], 
                                   region: readFile("${PROJECT_DIR}/.env").split('\n').find { it.startsWith('AWS_REGION=') }?.split('=')[1]) {
                                
                                def s3Bucket = readFile("${PROJECT_DIR}/.env").split('\n').find { it.startsWith('S3_BUCKET=') }?.split('=')[1]
                                def environment = params.ENVIRONMENT ?: 'dev'
                                
                                // Upload application archive
                                s3Upload(
                                    bucket: s3Bucket,
                                    path: "${environment}/builds/",
                                    includePathPattern: "yelpcamp-app-${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}.tar.gz"
                                )
                                
                                // Upload test results and coverage
                                s3Upload(
                                    bucket: s3Bucket,
                                    path: "${environment}/reports/${BUILD_NUMBER}/",
                                    includePathPattern: "coverage.html,coverage-summary.txt,test-results.txt,golangci-lint-report.xml"
                                )
                                
                                // Create and upload build metadata
                                writeFile file: 'build-metadata.json', text: """
{
    "build_number": "${BUILD_NUMBER}",
    "git_commit": "${env.GIT_COMMIT_SHORT}",
    "environment": "${environment}",
    "timestamp": "${env.BUILD_TIMESTAMP}",
    "docker_tag": "${DOCKER_TAG}",
    "artifacts": {
        "application": "yelpcamp-app-${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}.tar.gz",
        "docker_image": "${DOCKER_IMAGE}:${DOCKER_TAG}"
    }
}
"""
                                
                                s3Upload(
                                    bucket: s3Bucket,
                                    path: "${environment}/metadata/",
                                    includePathPattern: "build-metadata.json"
                                )
                            }
                            
                            echo "✅ Artifacts uploaded to S3 successfully"
                            
                        } catch (Exception e) {
                            echo "⚠️ S3 upload failed: ${e.getMessage()}"
                            echo "Continuing with local deployment..."
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
        
        stage('Deploy to Localhost') {
            when {
                expression { return params.DEPLOY_LOCALLY }
            }
            steps {
                echo "🚀 Deploying to localhost..."
                
                dir("${PROJECT_DIR}") {
                    script {
                        try {
                            sh '''
                                # Load environment variables
                                set -a
                                source .env
                                set +a
                                
                                ENVIRONMENT=${ENVIRONMENT:-dev}
                                
                                # Deploy based on environment
                                if [ "${ENVIRONMENT}" = "prod" ]; then
                                    echo "Deploying to PRODUCTION environment..."
                                    docker-compose -f docker-compose.prod.yml down || echo "No existing containers"
                                    docker-compose -f docker-compose.prod.yml up -d --build
                                else
                                    echo "Deploying to DEVELOPMENT environment..."
                                    docker-compose -f docker-compose.dev.yml down || echo "No existing containers"
                                    docker-compose -f docker-compose.dev.yml up -d --build
                                fi
                                
                                echo "Waiting for services to start..."
                                sleep 30
                                
                                echo "Checking service health..."
                                docker-compose ps
                            '''
                            
                            echo "✅ Deployment completed successfully!"
                            echo "🌐 Application should be running at: http://localhost:3000"
                            
                        } catch (Exception e) {
                            echo "❌ Deployment failed: ${e.getMessage()}"
                            
                            // Show logs for debugging
                            sh '''
                                echo "=== Application Logs ==="
                                docker-compose logs app || echo "No app logs available"
                                echo "=== MongoDB Logs ==="
                                docker-compose logs mongo || echo "No mongo logs available"
                            '''
                            
                            echo "⚠️ Deployment failed, but continuing..."
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
        
        stage('Post-Deployment Tests') {
            when {
                expression { return params.DEPLOY_LOCALLY }
            }
            steps {
                echo "🔍 Running post-deployment tests..."
                
                script {
                    try {
                        sh '''
                            echo "Testing API endpoints..."
                            
                            # Test health endpoint
                            echo "Testing /health endpoint..."
                            curl -f http://localhost:3000/health || echo "Health check failed"
                            
                            # Test campgrounds endpoint
                            echo "Testing /api/campgrounds endpoint..."
                            curl -f http://localhost:3000/api/campgrounds || echo "Campgrounds endpoint failed"
                            
                            echo "✅ Post-deployment tests completed"
                        '''
                        
                        echo "✅ Post-deployment tests passed"
                    } catch (Exception e) {
                        echo "⚠️ Some post-deployment tests failed: ${e.getMessage()}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo "🧹 Cleaning up..."
            
            dir("${PROJECT_DIR}") {
                // Clean up workspace but keep important artifacts
                sh '''
                    # Keep important files
                    mkdir -p keep
                    cp *.tar.gz keep/ 2>/dev/null || echo "No tar.gz files to keep"
                    cp coverage.html keep/ 2>/dev/null || echo "No coverage.html to keep"
                    cp build-metadata.json keep/ 2>/dev/null || echo "No build-metadata.json to keep"
                    
                    # Clean up build files
                    rm -f yelpcamp-app
                    rm -f coverage.out
                    rm -f test-results.txt
                    
                    # Restore important files
                    cp keep/* . 2>/dev/null || echo "No files to restore"
                    rm -rf keep
                '''
            }
        }
        
        success {
            echo "🎉 Pipeline completed successfully!"
            echo "📋 Build Summary:"
            echo "  - Environment: ${params.ENVIRONMENT ?: 'dev'}"
            echo "  - Build Number: ${BUILD_NUMBER}"
            echo "  - Git Commit: ${env.GIT_COMMIT_SHORT}"
            echo "  - Docker Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
            echo "  - Application URL: http://localhost:3000"
        }
        
        failure {
            echo "❌ Pipeline failed!"
            
            dir("${PROJECT_DIR}") {
                // Show container logs for debugging
                sh '''
                    echo "=== Container Status ==="
                    docker ps -a || echo "Cannot list containers"
                    
                    echo "=== Application Logs ==="
                    docker-compose logs app || echo "No app logs available"
                    
                    echo "=== MongoDB Logs ==="
                    docker-compose logs mongo || echo "No mongo logs available"
                '''
            }
        }
        
        unstable {
            echo "⚠️ Pipeline completed with warnings"
            echo "Check the logs above for details on what went wrong"
        }
    }
}
