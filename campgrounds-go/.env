# Local Development Environment File
# This file is safe to commit to version control
# Real secrets are managed through Jenkins credentials

# Server Configuration
PORT=3000
GIN_MODE=debug

# Database Configuration (local development only)
MONGODB_URI=mongodb://localhost:27017/campgrounds_local

# AWS Configuration (non-sensitive)
AWS_REGION=ca-central-1
AWS_S3_BUCKET=yelp-camp-project

# Session Secret (LOCAL DEVELOPMENT ONLY - NOT FOR PRODUCTION)
# Real secrets are managed through Jenkins credentials
SESSION_SECRET=local-dev-secret-not-for-production-use-only

# Application Configuration
APP_NAME=YelpCamp Go
APP_VERSION=1.0.0
LOG_LEVEL=debug

# Feature Flags (if needed)
ENABLE_DEBUG_LOGS=true
ENABLE_FILE_UPLOAD=true
