pipeline {
    agent any
    
    environment {
        GO_VERSION = '1.21'
        AWS_DEFAULT_REGION = 'ca-central-1'
        AWS_S3_BUCKET = 'yelp-camp-project'
        MONGODB_URI = 'mongodb://localhost:27017/campgrounds'
        
        // Environment specific variables
        DEV_PORT = '3001'
        PROD_PORT = '3000'
        
        // Go environment variables
        GOPROXY = 'https://proxy.golang.org,direct'
        GOSUMDB = 'sum.golang.org'
        GOPRIVATE = ''
    }
    
    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'prod'],
            description: 'Select deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip running tests'
        )
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
                
                script {
                    try {
                        sh 'git checkout develop'
                    } catch (Exception e) {
                        echo 'Develop branch does not exist, creating it...'
                        sh 'git checkout -b develop'
                        echo 'Created develop branch'
                    }
                }
            }
        }
        
        stage('Setup Go Environment') {
            steps {
                echo 'Setting up Go environment...'
                sh '''
                    # Install Go if not present
                    if ! command -v go &> /dev/null; then
                        echo "Installing Go..."
                        wget -q https://go.dev/dl/go1.21.0.linux-amd64.tar.gz
                        sudo tar -C /usr/local -xzf go1.21.0.linux-amd64.tar.gz
                    fi
                    
                    # Set up Go environment
                    export PATH=$PATH:/usr/local/go/bin
                    export GOPATH=$WORKSPACE/go
                    export GOPROXY=https://proxy.golang.org,direct
                    export GOSUMDB=sum.golang.org
                    
                    # Verify Go installation
                    go version
                    go env
                    
                    echo "Go environment setup completed"
                '''
            }
        }
        
        stage('Build') {
            steps {
                echo 'Building the application...'
                withCredentials([usernamePassword(credentialsId: 'github-auth', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                    sh '''
                        export PATH=$PATH:/usr/local/go/bin
                        export GOPATH=$WORKSPACE/go
                        export GOPROXY=https://proxy.golang.org,direct
                        export GOSUMDB=sum.golang.org
                        
                        # Configure Git credentials for Go module downloads
                        git config --global credential.helper store
                        echo "https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com" > ~/.git-credentials
                        git config --global url."https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/".insteadOf "https://github.com/"
                        
                        # Navigate to the Go project directory
                        cd campgrounds-go
                        
                        # Clean any existing modules
                        rm -f go.sum
                        
                        # Initialize and download dependencies with proper authentication
                        go mod download
                        go mod verify
                        
                        # Build the application
                        echo "Building application..."
                        go build -v -o campgrounds-go main.go
                        
                        # Verify build
                        if [ ! -f campgrounds-go ]; then
                            echo "Build failed: executable not found"
                            exit 1
                        fi
                        
                        echo "Build successful!"
                        ls -la campgrounds-go
                        file campgrounds-go
                        
                        # Clean up credentials for security
                        rm -f ~/.git-credentials
                        git config --global --unset credential.helper
                        git config --global --unset url."https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/".insteadOf
                    '''
                }
            }
            post {
                failure {
                    echo 'Build stage failed!'
                    sh 'cd campgrounds-go && ls -la && cat go.mod'
                }
            }
        }
        
        stage('Lint & Static Analysis') {
            steps {
                echo 'Running linting and static analysis...'
                sh '''
                    export PATH=$PATH:/usr/local/go/bin
                    cd campgrounds-go
                    
                    # Run go fmt check
                    echo "Checking code formatting..."
                    if [ "$(gofmt -s -l . | wc -l)" -gt 0 ]; then
                        echo "Code formatting issues found:"
                        gofmt -s -l .
                        echo "Running go fmt to fix issues..."
                        gofmt -s -w .
                    fi
                    
                    # Run go vet
                    echo "Running go vet..."
                    go vet ./...
                    
                    echo "Linting completed successfully!"
                '''
            }
            post {
                failure {
                    echo 'Linting stage failed but continuing...'
                }
            }
        }
        
        stage('Test') {
            when {
                expression { 
                    return !params.SKIP_TESTS 
                }
            }
            steps {
                echo 'Running tests...'
                sh '''
                    export PATH=$PATH:/usr/local/go/bin
                    export GOPATH=$WORKSPACE/go
                    cd campgrounds-go
                    
                    # Run tests with coverage
                    echo "Running unit tests..."
                    go test -v -race -coverprofile=coverage.out ./...
                    
                    # Generate coverage report if coverage file exists
                    if [ -f coverage.out ]; then
                        go tool cover -html=coverage.out -o coverage.html
                        echo "Coverage report generated"
                        go tool cover -func=coverage.out
                    fi
                    
                    echo "Tests completed successfully!"
                '''
            }
            post {
                always {
                    script {
                        if (fileExists('campgrounds-go/coverage.out')) {
                            archiveArtifacts artifacts: 'campgrounds-go/coverage.out,campgrounds-go/coverage.html', allowEmptyArchive: true
                        }
                    }
                }
                failure {
                    echo 'Test stage failed but continuing...'
                }
            }
        }
        
        stage('Build Artifacts') {
            steps {
                echo 'Creating deployment artifacts...'
                withCredentials([
                    string(credentialsId: 'SESSION_SECRET_DEV', variable: 'DEV_SESSION_SECRET'),
                    string(credentialsId: 'SESSION_SECRET_PROD', variable: 'PROD_SESSION_SECRET'),
                    string(credentialsId: 'MONGODB_URI_DEV', variable: 'DEV_MONGODB_URI'),
                    string(credentialsId: 'MONGODB_URI_PROD', variable: 'PROD_MONGODB_URI')
                ]) {
                    sh '''
                        export PATH=$PATH:/usr/local/go/bin
                        cd campgrounds-go
                        
                        # Create artifacts directory
                        mkdir -p artifacts
                        
                        # Build for different environments
                        if [ "${DEPLOY_ENV}" = "prod" ]; then
                            echo "Building production artifacts..."
                            CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o artifacts/campgrounds-go-prod main.go
                            
                            # Create production config
                            cat > artifacts/.env.prod << EOF
PORT=${PROD_PORT}
GIN_MODE=release
MONGODB_URI=${PROD_MONGODB_URI}
AWS_REGION=${AWS_DEFAULT_REGION}
AWS_S3_BUCKET=${AWS_S3_BUCKET}
SESSION_SECRET=${PROD_SESSION_SECRET}
EOF
                            echo "Production environment file created"
                        else
                            echo "Building development artifacts..."
                            CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o artifacts/campgrounds-go-dev main.go
                            
                            # Create development config
                            cat > artifacts/.env.dev << EOF
PORT=${DEV_PORT}
GIN_MODE=debug
MONGODB_URI=${DEV_MONGODB_URI}
AWS_REGION=${AWS_DEFAULT_REGION}
AWS_S3_BUCKET=${AWS_S3_BUCKET}
SESSION_SECRET=${DEV_SESSION_SECRET}
EOF
                            echo "Development environment file created"
                        fi
                        
                        # Create deployment script
                        cat > artifacts/deploy.sh << 'EOF'
#!/bin/bash
ENV=${1:-dev}
echo "Deploying to $ENV environment..."

# Load environment variables
if [ -f ".env.$ENV" ]; then
    export $(cat .env.$ENV | grep -v '^#' | xargs)
    echo "Loaded environment variables for $ENV"
else
    echo "Warning: .env.$ENV file not found"
fi

# Stop existing process
pkill -f campgrounds-go-$ENV || echo "No existing process found"

# Wait a moment for process to stop
sleep 2

# Start new process
if [ "$ENV" = "prod" ]; then
    echo "Starting production server on port $PORT..."
    nohup ./campgrounds-go-prod > campgrounds-prod.log 2>&1 &
    PROCESS_PID=$!
    echo "Production server started with PID: $PROCESS_PID"
else
    echo "Starting development server on port $PORT..."
    nohup ./campgrounds-go-dev > campgrounds-dev.log 2>&1 &
    PROCESS_PID=$!
    echo "Development server started with PID: $PROCESS_PID"
fi

# Wait a moment and check if process is running
sleep 3
if ps -p $PROCESS_PID > /dev/null; then
    echo "✅ Deployment successful! Server is running on port $PORT"
else
    echo "❌ Deployment failed! Server is not running"
    exit 1
fi

echo "Deployment completed!"
EOF
                        
                        chmod +x artifacts/deploy.sh
                        
                        # Create health check script
                        cat > artifacts/health-check.sh << 'EOF'
#!/bin/bash
ENV=${1:-dev}
PORT=${2:-3001}

if [ "$ENV" = "prod" ]; then
    PORT=3000
fi

echo "Performing health check on port $PORT..."

# Wait for server to start
sleep 5

# Perform health check
RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:$PORT/health)

if [ "$RESPONSE" = "200" ]; then
    echo "✅ Health check passed! Server is healthy on port $PORT"
    curl -s http://localhost:$PORT/health | jq '.' || echo "Health check response received"
    exit 0
else
    echo "❌ Health check failed! HTTP status: $RESPONSE"
    echo "Server logs:"
    if [ "$ENV" = "prod" ]; then
        tail -20 campgrounds-prod.log || echo "No log file found"
    else
        tail -20 campgrounds-dev.log || echo "No log file found"
    fi
    exit 1
fi
EOF
                        
                        chmod +x artifacts/health-check.sh
                        
                        # Create archive
                        tar -czf campgrounds-go-${DEPLOY_ENV}-${BUILD_NUMBER}.tar.gz -C artifacts .
                        
                        echo "Artifacts created successfully!"
                        ls -la artifacts/
                        ls -la *.tar.gz
                    '''
                }
            }
        }
        
        stage('Upload to S3') {
            steps {
                echo 'Uploading artifacts to S3...'
                withCredentials([aws(credentialsId: 'AWSCREDENTIALS', region: 'ca-central-1')]) {
                    sh '''
                        cd campgrounds-go
                        
                        # Upload artifacts to S3
                        echo "Uploading campgrounds-go-${DEPLOY_ENV}-${BUILD_NUMBER}.tar.gz to S3..."
                        aws s3 cp campgrounds-go-${DEPLOY_ENV}-${BUILD_NUMBER}.tar.gz \
                            s3://${AWS_S3_BUCKET}/artifacts/${DEPLOY_ENV}/campgrounds-go-${BUILD_NUMBER}.tar.gz \
                            --metadata "build-number=${BUILD_NUMBER},environment=${DEPLOY_ENV},timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                        
                        # Upload latest version
                        echo "Uploading latest version..."
                        aws s3 cp campgrounds-go-${DEPLOY_ENV}-${BUILD_NUMBER}.tar.gz \
                            s3://${AWS_S3_BUCKET}/artifacts/${DEPLOY_ENV}/campgrounds-go-latest.tar.gz \
                            --metadata "build-number=${BUILD_NUMBER},environment=${DEPLOY_ENV},timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                        
                        echo "✅ Artifacts uploaded to S3 successfully!"
                        
                        # List uploaded files
                        echo "Files in S3 bucket:"
                        aws s3 ls s3://${AWS_S3_BUCKET}/artifacts/${DEPLOY_ENV}/ --human-readable
                    '''
                }
            }
            post {
                failure {
                    echo 'S3 upload failed but continuing...'
                }
            }
        }
        
        stage('Deploy to Dev') {
            when {
                anyOf {
                    branch 'develop'
                    expression { return params.DEPLOY_ENV == 'dev' }
                }
            }
            steps {
                echo 'Deploying to Development environment...'
                sh '''
                    cd campgrounds-go
                    
                    # Create deployment directory
                    sudo mkdir -p /opt/campgrounds-dev/
                    sudo chown jenkins:jenkins /opt/campgrounds-dev/
                    
                    # Extract artifacts
                    tar -xzf campgrounds-go-dev-${BUILD_NUMBER}.tar.gz -C /opt/campgrounds-dev/
                    
                    # Deploy to development
                    cd /opt/campgrounds-dev/
                    ./deploy.sh dev
                    
                    # Health check
                    ./health-check.sh dev
                    
                    echo "✅ Development deployment completed successfully!"
                '''
            }
            post {
                success {
                    echo '✅ Development deployment successful!'
                }
                failure {
                    echo '❌ Development deployment failed!'
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                anyOf {
                    branch 'main'
                    expression { return params.DEPLOY_ENV == 'prod' }
                }
            }
            steps {
                echo 'Deploying to Production environment...'
                
                // Manual approval for production
                script {
                    def deployApproval = input(
                        message: 'Deploy to Production?',
                        ok: 'Deploy',
                        parameters: [
                            booleanParam(
                                name: 'CONFIRM_DEPLOYMENT',
                                defaultValue: false,
                                description: 'Check this box to confirm production deployment'
                            )
                        ]
                    )
                    
                    if (!deployApproval) {
                        error('Production deployment cancelled by user')
                    }
                }
                
                sh '''
                    cd campgrounds-go
                    
                    # Create deployment directory
                    sudo mkdir -p /opt/campgrounds-prod/
                    sudo chown jenkins:jenkins /opt/campgrounds-prod/
                    
                    # Extract artifacts
                    tar -xzf campgrounds-go-prod-${BUILD_NUMBER}.tar.gz -C /opt/campgrounds-prod/
                    
                    # Deploy to production
                    cd /opt/campgrounds-prod/
                    ./deploy.sh prod
                    
                    # Health check
                    ./health-check.sh prod
                    
                    echo "✅ Production deployment completed successfully!"
                '''
            }
            post {
                success {
                    echo '✅ Production deployment successful!'
                    // Add notifications here (email, Slack, etc.)
                }
                failure {
                    echo '❌ Production deployment failed!'
                    // Add failure notifications here
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed!'
            
            script {
                if (fileExists('campgrounds-go/*.tar.gz')) {
                    archiveArtifacts artifacts: 'campgrounds-go/*.tar.gz', allowEmptyArchive: true
                }
            }
        }
        
        success {
            echo '✅ Pipeline succeeded!'
            // Add success notifications here
        }
        
        failure {
            echo '❌ Pipeline failed!'
            // Add failure notifications here
        }
        
        unstable {
            echo '⚠️ Pipeline is unstable!'
        }
    }
}
