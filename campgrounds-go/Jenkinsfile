pipeline {
    agent any
    
    environment {
        GO_VERSION = '1.21'
        GOPATH = "${WORKSPACE}/go"
        APP_NAME = 'campgrounds-go'
        DEV_PORT = '3001'
        PROD_PORT = '3000'
    }
    
    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'prod', 'both'],
            description: 'Select deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip running tests'
        )
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }
    
    stages {
        stage('🧹 Clean Workspace') {
            steps {
                echo '🧹 Cleaning workspace and Go cache...'
                sh '''
                    # Clean workspace (skip permission errors)
                    rm -rf ${WORKSPACE}/* || true
                    
                    # Clean Go cache if available
                    if command -v go &> /dev/null; then
                        export PATH=$PATH:/usr/local/go/bin
                        go clean -cache -modcache -testcache 2>/dev/null || echo "Go cache clean completed"
                    fi
                    
                    echo "✅ Workspace cleaned"
                '''
            }
        }
        
        stage('📥 Checkout Source Code') {
            steps {
                echo '📥 Checking out source code...'
                checkout scm
                
                sh '''
                    echo "📋 Current commit information:"
                    git log --oneline -5
                    echo "📂 Repository structure:"
                    find . -name "*.go" -o -name "*.mod" -o -name "*.sum" -o -name "Jenkinsfile" | head -10
                    echo "📁 Current directory contents:"
                    ls -la
                '''
            }
        }
        
        stage('🔧 Setup Go Environment') {
            steps {
                echo '🔧 Setting up Go environment...'
                sh '''
                    # Install Go if not present
                    if ! command -v go &> /dev/null || ! go version | grep -q "${GO_VERSION}"; then
                        echo "📦 Installing Go ${GO_VERSION}..."
                        cd /tmp
                        wget -q https://go.dev/dl/go${GO_VERSION}.0.linux-amd64.tar.gz
                        sudo rm -rf /usr/local/go
                        sudo tar -C /usr/local -xzf go${GO_VERSION}.0.linux-amd64.tar.gz
                        rm go${GO_VERSION}.0.linux-amd64.tar.gz
                    fi
                    
                    # Set up Go environment
                    export PATH=$PATH:/usr/local/go/bin:${GOPATH}/bin
                    mkdir -p ${GOPATH}/{src,bin,pkg}
                    
                    # Git configuration
                    git config --global url."https://".insteadOf git://
                    git config --global url."https://github.com/".insteadOf "git@github.com:"
                    
                    # Verify Go installation
                    go version
                    echo "✅ Go environment setup completed"
                '''
            }
        }
        
        stage('📦 Download Dependencies') {
            steps {
                echo '📦 Downloading Go dependencies...'
                script {
                    // Check if campgrounds-go directory exists
                    if (fileExists('campgrounds-go')) {
                        dir('campgrounds-go') {
                            sh '''
                                export PATH=$PATH:/usr/local/go/bin:${GOPATH}/bin
                                
                                echo "📁 Contents of campgrounds-go directory:"
                                ls -la
                                
                                # Check if go.mod exists
                                if [ -f go.mod ]; then
                                    echo "📦 Found go.mod, downloading dependencies..."
                                    rm -f go.sum
                                    go mod download
                                    go mod verify
                                    go mod tidy
                                    echo "✅ Dependencies downloaded"
                                else
                                    echo "❌ No go.mod found in campgrounds-go directory"
                                    exit 1
                                fi
                            '''
                        }
                    } else {
                        error("❌ campgrounds-go directory not found in repository")
                    }
                }
            }
        }
        
        stage('🔍 Code Quality') {
            steps {
                echo '🔍 Running code quality checks...'
                dir('campgrounds-go') {
                    script {
                        try {
                            sh '''
                                export PATH=$PATH:/usr/local/go/bin:${GOPATH}/bin
                                
                                echo "🔍 Running go fmt..."
                                if [ "$(gofmt -l . | wc -l)" -gt 0 ]; then
                                    echo "⚠️ Code formatting issues found:"
                                    gofmt -l .
                                fi
                                
                                echo "🔍 Running go vet..."
                                go vet ./...
                                
                                echo "✅ Code quality checks completed"
                            '''
                        } catch (Exception e) {
                            echo "⚠️ Code quality issues found: ${e.getMessage()}"
                        }
                    }
                }
            }
        }
        
        stage('🔨 Build Application') {
            steps {
                echo '🔨 Building the Go application...'
                dir('campgrounds-go') {
                    sh '''
                        export PATH=$PATH:/usr/local/go/bin:${GOPATH}/bin
                        export CGO_ENABLED=0
                        export GOOS=linux
                        
                        echo "🔨 Building application..."
                        go build -a -installsuffix cgo -o ${APP_NAME} main.go
                        
                        # Verify build
                        if [ ! -f ${APP_NAME} ]; then
                            echo "❌ Build failed: executable not found"
                            exit 1
                        fi
                        
                        # Create environment-specific binaries
                        cp ${APP_NAME} ${APP_NAME}-dev
                        cp ${APP_NAME} ${APP_NAME}-prod
                        
                        ls -la ${APP_NAME}*
                        echo "✅ Build completed successfully!"
                    '''
                }
            }
        }
        
        stage('🧪 Run Tests') {
            steps {
                script {
                    if (!params.SKIP_TESTS) {
                        echo '🧪 Running tests...'
                        dir('campgrounds-go') {
                            try {
                                sh '''
                                    export PATH=$PATH:/usr/local/go/bin:${GOPATH}/bin
                                    
                                    echo "🧪 Running unit tests..."
                                    go test -v -race -coverprofile=coverage.out ./...
                                    
                                    if [ -f coverage.out ]; then
                                        echo "📊 Generating coverage report..."
                                        go tool cover -html=coverage.out -o coverage.html
                                        go tool cover -func=coverage.out
                                    fi
                                    
                                    echo "✅ Tests completed successfully!"
                                '''
                            } catch (Exception e) {
                                echo "⚠️ Tests failed: ${e.getMessage()}"
                                // Continue anyway for demo purposes
                            }
                        }
                    } else {
                        echo '⏭️ Skipping tests as requested'
                    }
                }
            }
            post {
                always {
                    dir('campgrounds-go') {
                        script {
                            if (fileExists('coverage.out')) {
                                archiveArtifacts artifacts: 'coverage.out,coverage.html', allowEmptyArchive: true
                            }
                        }
                    }
                }
            }
        }
        
        stage('📦 Create Artifacts') {
            steps {
                echo '📦 Creating deployment artifacts...'
                dir('campgrounds-go') {
                    sh '''
                        echo "📦 Creating deployment packages..."
                        
                        # Create artifact directories
                        mkdir -p artifacts/dev artifacts/prod
                        
                        # Package for development
                        tar -czf artifacts/dev/${APP_NAME}-dev-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-dev templates/ static/ go.mod go.sum README.md 2>/dev/null || \
                        tar -czf artifacts/dev/${APP_NAME}-dev-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-dev go.mod go.sum 2>/dev/null || \
                        tar -czf artifacts/dev/${APP_NAME}-dev-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-dev
                        
                        # Package for production
                        tar -czf artifacts/prod/${APP_NAME}-prod-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-prod templates/ static/ go.mod go.sum README.md 2>/dev/null || \
                        tar -czf artifacts/prod/${APP_NAME}-prod-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-prod go.mod go.sum 2>/dev/null || \
                        tar -czf artifacts/prod/${APP_NAME}-prod-${BUILD_NUMBER}.tar.gz \
                            ${APP_NAME}-prod
                        
                        echo "📋 Artifacts created:"
                        ls -la artifacts/dev/ artifacts/prod/
                        echo "✅ Artifacts created successfully"
                    '''
                }
            }
        }
        
        stage('🚀 Deploy to Development') {
            steps {
                script {
                    if (params.DEPLOY_ENV == 'dev' || params.DEPLOY_ENV == 'both') {
                        echo '🚀 Deploying to Development environment...'
                        dir('campgrounds-go') {
                            sh '''
                                echo "🚀 Starting development deployment..."
                                
                                # Kill existing processes
                                pkill -f "${APP_NAME}-dev" || echo "No existing dev process"
                                sleep 2
                                
                                # Start development server
                                export PORT=${DEV_PORT}
                                export GIN_MODE=debug
                                
                                echo "Starting development server on port ${DEV_PORT}..."
                                nohup ./${APP_NAME}-dev > dev-app.log 2>&1 &
                                DEV_PID=$!
                                echo $DEV_PID > dev-app.pid
                                
                                # Wait and verify
                                sleep 5
                                if kill -0 $DEV_PID 2>/dev/null; then
                                    echo "✅ Development server started (PID: $DEV_PID)"
                                else
                                    echo "❌ Development server failed to start"
                                    cat dev-app.log || echo "No log file found"
                                    exit 1
                                fi
                                
                                # Health check
                                echo "🏥 Health check..."
                                for i in {1..10}; do
                                    if curl -f http://localhost:${DEV_PORT}/health 2>/dev/null; then
                                        echo "✅ Development health check passed"
                                        break
                                    fi
                                    echo "⏳ Waiting... ($i/10)"
                                    sleep 3
                                done
                            '''
                        }
                    } else {
                        echo '⏭️ Skipping development deployment'
                    }
                }
            }
        }
        
        stage('🚀 Deploy to Production') {
            steps {
                script {
                    if (params.DEPLOY_ENV == 'prod' || params.DEPLOY_ENV == 'both') {
                        // Manual approval for production
                        try {
                            timeout(time: 5, unit: 'MINUTES') {
                                input message: '🚀 Deploy to Production?', ok: 'Deploy'
                            }
                        } catch (Exception e) {
                            echo "❌ Production deployment not approved or timed out"
                            return
                        }
                        
                        echo '🚀 Deploying to Production environment...'
                        dir('campgrounds-go') {
                            sh '''
                                echo "🚀 Starting production deployment..."
                                
                                # Kill existing processes
                                pkill -f "${APP_NAME}-prod" || echo "No existing prod process"
                                sleep 2
                                
                                # Start production server
                                export PORT=${PROD_PORT}
                                export GIN_MODE=release
                                
                                echo "Starting production server on port ${PROD_PORT}..."
                                nohup ./${APP_NAME}-prod > prod-app.log 2>&1 &
                                PROD_PID=$!
                                echo $PROD_PID > prod-app.pid
                                
                                # Wait and verify
                                sleep 5
                                if kill -0 $PROD_PID 2>/dev/null; then
                                    echo "✅ Production server started (PID: $PROD_PID)"
                                else
                                    echo "❌ Production server failed to start"
                                    cat prod-app.log || echo "No log file found"
                                    exit 1
                                fi
                                
                                # Health check
                                echo "🏥 Health check..."
                                for i in {1..10}; do
                                    if curl -f http://localhost:${PROD_PORT}/health 2>/dev/null; then
                                        echo "✅ Production health check passed"
                                        break
                                    fi
                                    echo "⏳ Waiting... ($i/10)"
                                    sleep 3
                                done
                            '''
                        }
                    } else {
                        echo '⏭️ Skipping production deployment'
                    }
                }
            }
        }
        
        stage('🧪 Post-Deployment Tests') {
            steps {
                echo '🧪 Running post-deployment tests...'
                dir('campgrounds-go') {
                    script {
                        if (params.DEPLOY_ENV == 'dev' || params.DEPLOY_ENV == 'both') {
                            echo "🧪 Testing Development environment..."
                            sh """
                                curl -f http://localhost:${DEV_PORT}/health || echo "Dev health check failed"
                                curl -f http://localhost:${DEV_PORT}/api/campgrounds || echo "Dev API check failed"
                                curl -f http://localhost:${DEV_PORT}/ || echo "Dev web check failed"
                                echo "✅ Development tests completed"
                            """
                        }
                        
                        if (params.DEPLOY_ENV == 'prod' || params.DEPLOY_ENV == 'both') {
                            echo "🧪 Testing Production environment..."
                            sh """
                                curl -f http://localhost:${PROD_PORT}/health || echo "Prod health check failed"
                                curl -f http://localhost:${PROD_PORT}/api/campgrounds || echo "Prod API check failed"
                                curl -f http://localhost:${PROD_PORT}/ || echo "Prod web check failed"
                                echo "✅ Production tests completed"
                            """
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo '🏁 Pipeline completed!'
            dir('campgrounds-go') {
                script {
                    if (fileExists('artifacts')) {
                        archiveArtifacts artifacts: 'artifacts/**/*', allowEmptyArchive: true
                    }
                    if (fileExists('*.log')) {
                        archiveArtifacts artifacts: '*.log', allowEmptyArchive: true
                    }
                }
            }
        }
        
        success {
            echo '✅ Pipeline succeeded! 🎉'
            script {
                def message = "🎉 Deployment Summary:\n📦 Build: ${env.BUILD_NUMBER}\n"
                if (params.DEPLOY_ENV == 'dev' || params.DEPLOY_ENV == 'both') {
                    message += "🚀 Development: http://localhost:${env.DEV_PORT}\n"
                }
                if (params.DEPLOY_ENV == 'prod' || params.DEPLOY_ENV == 'both') {
                    message += "🚀 Production: http://localhost:${env.PROD_PORT}\n"
                }
                echo message
            }
        }
        
        failure {
            echo '❌ Pipeline failed!'
            dir('campgrounds-go') {
                sh 'pkill -f "${APP_NAME}" || true'
            }
        }
    }
}
